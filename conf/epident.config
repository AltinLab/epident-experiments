profiles {
    gemini {

        process {
            withLabel: epident_local {
                executor = 'local'
                conda = "$HOME/miniconda3/envs/epident-experiments"
            }
            withLabel: mmseqs {
                executor = 'slurm'
                queue = 'compute'
                cpus = '8'
                memory = '16GB'
                clusterOptions = '--time=1:00:00'
                conda = "$HOME/miniconda3/envs/mmseqs2"
            }
        }

    }
}
